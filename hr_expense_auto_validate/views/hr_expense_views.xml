<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_sheet_form_inherit_validate_label_auto" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.validate.label.auto</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_submit_sheet']" position="attributes">
                <attribute name="string">Validar</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_form_inherit_validate_button_auto" model="ir.ui.view">
        <field name="name">hr.expense.form.validate.button.auto</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_submit_expenses']" position="attributes">
                <attribute name="string">Validar</attribute>
            </xpath>
        </field>
    </record>
</odoo>
