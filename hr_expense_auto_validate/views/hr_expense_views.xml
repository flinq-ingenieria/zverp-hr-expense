<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_confirm_button" model="ir.ui.view">
        <field name="name">hr.expense.view.form.confirm.button</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_submit_expenses' and contains(@class, 'o_expense_submit')]" position="attributes">
                <attribute name="string">Confirm</attribute>
            </xpath>
        </field>
    </record>
</odoo>
