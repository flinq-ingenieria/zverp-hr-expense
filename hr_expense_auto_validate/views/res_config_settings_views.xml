<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_hr_expense_auto_validate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.expense.auto.validate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='expenses_setting_container']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="expense_auto_process_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="expense_auto_process_enabled" string="Auto Validate Expenses"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Employees can validate and trigger approval + accounting document creation automatically.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
