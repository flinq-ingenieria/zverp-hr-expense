<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_expenses_analysis_tree_inherit_vendor_bill" model="ir.ui.view">
        <field name="name">hr.expense.tree.vendor.bill</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <field name="payment_mode" position="after">
                <field name="expense_document_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_expense_view_form_inherit_vendor_bill" model="ir.ui.view">
        <field name="name">hr.expense.form.vendor.bill</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='payment_mode']" position="after">
                <field name="expense_document_type"/>
            </xpath>
            <xpath expr="//field[@name='reference']" position="after">
                <label for="invoice_partner_id" attrs="{'invisible': [('expense_document_type', '!=', 'invoice')]}"/>
                <div attrs="{'invisible': [('expense_document_type', '!=', 'invoice')]}">
                    <field name="invoice_partner_id"/>
                </div>
                <field name="invoice_number" attrs="{'invisible': [('expense_document_type', '!=', 'invoice')]}"/>
                <field name="invoice_date_manual" attrs="{'invisible': [('expense_document_type', '!=', 'invoice')]}"/>
                <field name="invoice_notes" attrs="{'invisible': [('expense_document_type', '!=', 'invoice')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
