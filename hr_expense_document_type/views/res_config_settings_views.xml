<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_hr_expense_document_type" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.expense.document.type</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='expenses_setting_container']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="expense_default_document_type" string="Default Expense Type"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Choose if new expenses default to Gasto or Factura.
                        </div>
                        <div class="row mt8">
                            <field name="expense_default_document_type"/>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="expense_entry_journal_id" string="Expense Entry Journal"/>
                        <div class="text-muted">
                            Miscellaneous journal used when expense line type is Gasto.
                        </div>
                        <div class="row mt8">
                            <field name="expense_entry_journal_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
