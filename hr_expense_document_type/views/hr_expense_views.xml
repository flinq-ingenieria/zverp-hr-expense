<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_expenses_analysis_tree_inherit_document_type" model="ir.ui.view">
        <field name="name">hr.expense.tree.document.type</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <field name="payment_mode" position="after">
                <field name="expense_document_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_expense_view_form_inherit_document_type" model="ir.ui.view">
        <field name="name">hr.expense.form.document.type</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='payment_mode']" position="after">
                <field name="expense_document_type" attrs="{'invisible': [('payment_mode', '!=', 'own_account')]}"/>
            </xpath>
            <xpath expr="//field[@name='reference']" position="after">
                <label
                    for="invoice_partner_id"
                    attrs="{'invisible': ['|', ('expense_document_type', '!=', 'invoice'), ('payment_mode', '!=', 'own_account')]}"
                />
                <div attrs="{'invisible': ['|', ('expense_document_type', '!=', 'invoice'), ('payment_mode', '!=', 'own_account')]}">
                    <field name="invoice_partner_id"/>
                </div>
                <field
                    name="invoice_number"
                    attrs="{'invisible': ['|', ('expense_document_type', '!=', 'invoice'), ('payment_mode', '!=', 'own_account')]}"
                />
                <field
                    name="invoice_date_manual"
                    attrs="{'invisible': ['|', ('expense_document_type', '!=', 'invoice'), ('payment_mode', '!=', 'own_account')]}"
                />
                <field
                    name="invoice_notes"
                    attrs="{'invisible': ['|', ('expense_document_type', '!=', 'invoice'), ('payment_mode', '!=', 'own_account')]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
